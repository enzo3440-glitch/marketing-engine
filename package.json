{
  "name": "marketing-engine",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --filter @engine/web dev",
    "dev:worker": "pnpm --filter @engine/worker dev",
    "mcp": "pnpm --silent --filter @engine/mcp start",
    "desk": "pnpm --filter @engine/web build && pnpm --filter @engine/web exec next start -p 3000",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @engine/advisor test",
    "seed": "pnpm --filter @engine/db seed",
    "import:cmo": "pnpm --filter @engine/db import:cmo",
    "db:types": "pnpm --filter @engine/db types"
  }
}
