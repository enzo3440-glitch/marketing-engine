# Marketing Engine settings. Copy this file to .env and fill it in (SETUP.md walks you through every line).
# .env is gitignored: never commit it, paste it into a chat, or share a screenshot of it.
# Every variable is optional: with none set the desk runs on example data so you can look around first.

# --- Your brand (SETUP.md step 6) ----------------------------------------------------------------
BRAND_NAME=                  # e.g. Acme
BRAND_PITCH=                 # one line: what it is and who it's for
BRAND_NICHE=                 # e.g. travel, cooking, fitness, skincare
BRAND_GOAL=                  # what ads should drive, e.g. App Store downloads, website sign-ups
BRAND_IG_HANDLE=             # your Instagram handle, without @
BRAND_TAGLINE=               # short line for end cards (optional)
BRAND_CTA=                   # call to action on end cards, e.g. "Free on iPhone" (optional)
BRAND_STORE_LINE=            # optional store line on end cards

# --- AI: Claude Code on your subscription login (SETUP.md step 2) ---------------------------------
# The desk runs `claude -p` headless on your signed-in Claude account. Do NOT set an API key here.
CLAUDE_CLI=                  # path to the claude executable, only if it isn't on PATH
CLAUDE_MODEL=claude-opus-5-5

# --- Meta: Instagram + Ads (SETUP.md steps 3-5) ---------------------------------------------------
# A long-lived token with: instagram_basic, instagram_content_publish, instagram_manage_insights,
# instagram_manage_contents, ads_management, ads_read, pages_show_list, pages_read_engagement, business_management
META_ACCESS_TOKEN=
META_IG_USER_ID=             # the Instagram professional account id (a long number)
META_PAGE_ID=                # the Facebook Page linked to that Instagram account
META_AD_ACCOUNT_ID=          # with or without the act_ prefix
META_APP_ID=                 # only for "App installs" campaigns
META_API_VERSION=v24.0
META_MAX_DAILY_BUDGET=20     # the desk refuses to send anything above this per day for approval
META_COUNTRIES=US            # default ad targeting
META_DEFAULT_LINK=           # where ad buttons go: your App Store / website link

# --- Reel engine (services/reel-engine) -----------------------------------------------------------
VIDEO_ENGINE_URL=http://127.0.0.1:8787   # unset = stub renders with no media
REEL_TOKEN=                  # any long random string; the desk and the engine must share it
REEL_DATA_DIR=               # default services/reel-engine/reel-data
AUTOPILOT_ROOTS=             # folders of your own footage the engine may read, separated by ;
NARRATION_VOICE=             # optional: path to your own Piper .onnx voice for narrated videos

# --- Trends (optional): accounts whose top reels the desk studies daily ---------------------------
DESK_TREND_ACCOUNTS=         # comma-separated Instagram handles in your niche, without @
TREND_HASHTAGS=              # optional: hashtags for the trend prompt (default from BRAND_NICHE)
BANNED_SOUNDS=               # optional: a regex of songs the desk must never use

# --- Optional: app ads built from your own app's code (/brag ads) ----------------------------------
APP_DIR=                     # path to a local git checkout of your app; unset = ads made without app screens from code
APP_REF=origin/main          # the branch or ref that holds your app's latest version

# --- Posting switches (leave off until your first video looks right on Launch) ---------------------
DESK_TRIAL_POSTING=off       # on = Launch may post trial reels to Instagram after your one Approve
DESK_TRIAL_BATCH=off
DESK_AUTOPILOT=on            # off = no automatic re-cut proposals
DESK_ACT_REACH=500           # saves+shares only count past this reach

# --- Optional: Supabase for persistence and login (without it data lives on this machine) ------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
MOCK_ROLE=ceo
OPS_DATA_DIR=
